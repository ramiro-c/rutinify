# URL base del backend de sync (contrato en db/sync-protocol.md).
# Sin ella, la app funciona 100 % local y el flujo celular ↔ desktop
# es el export/import JSON. Con ella, el cliente hace pull/merge LWW
# al reconectar y push best-effort del estado convergido.
VITE_SYNC_URL=
# Token de API para el sync celular ↔ desktop (BET-2026-001).
# El cliente lo lee como VITE_API_TOKEN y lo envía como Bearer.
VITE_API_TOKEN=

# Backend de referencia (server/sync-server.mjs, cero dependencias).
# Levantarlo: SYNC_API_TOKEN=<mismo token> node server/sync-server.mjs
# o: docker build -f server/Dockerfile -t rutinify-sync . && docker run -p 8787:8787 -e SYNC_API_TOKEN=<token> -v sync-data:/data rutinify-sync
SYNC_PORT=8787
SYNC_API_TOKEN=
SYNC_DATA_PATH=./data/sync-state.json
